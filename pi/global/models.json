{
  "providers": {
    "ollama-cloud": {
      "baseUrl": "https://ollama.com/v1",
      "api": "openai-completions",
      "apiKey": "${OLLAMA_API_KEY}",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false
      },
      "models": [
        {
          "id": "mistral-large-4",
          "name": "Mistral Large 4 (Ollama Cloud)",
          "_notes": "Large open-weight model — cloud escalation for the hard 20%; prompts leave your network",
          "input": ["text"],
          "contextWindow": 131072,
          "maxTokens": 32768
        },
        {
          "id": "nemotron-3-ultra",
          "name": "Nemotron 3 Ultra (Ollama Cloud)",
          "_notes": "Large open-weight model — cloud escalation",
          "input": ["text"],
          "contextWindow": 131072,
          "maxTokens": 32768
        },
        {
          "id": "gemma4",
          "name": "Gemma 4 (Ollama Cloud)",
          "_notes": "Cloud copy of the local Gemma 4 family — fallback when the local host is down",
          "input": ["text"],
          "contextWindow": 131072,
          "maxTokens": 32768
        }
      ]
    },
    "ollama-lan": {
      "baseUrl": "http://YOUR-OLLAMA-HOST:11434/v1",
      "api": "openai-completions",
      "apiKey": "ollama",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": true,
        "supportsUsageInStreaming": false,
        "maxTokensField": "max_tokens"
      },
      "models": [
        {
          "id": "flint-agent:latest",
          "name": "Flint 40B-A2B Agent",
          "_notes": "Default. MoE (~2.5B active), reasoning + tools. Built from Modelfile-flint-agent (Apple Silicon qat-int4 build). maxTokens 32768: 8192 truncates reasoning + multi-file writes",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 131072,
          "maxTokens": 32768
        },
        {
          "id": "gemma4-31b-agent:latest",
          "name": "Gemma 4 31B Agent",
          "_notes": "Dense, slower, equally reliable fallback. Built from Modelfile-gemma4-agent",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 131072,
          "maxTokens": 32768
        },
        {
          "id": "gemma4-26b-agent:latest",
          "name": "Gemma 4 26B Agent",
          "_notes": "Faster Gemma with image input — use for screenshots/diagrams. Built from Modelfile-gemma4-agent (swap FROM)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 131072,
          "maxTokens": 32768
        }
      ]
    }
  }
}
